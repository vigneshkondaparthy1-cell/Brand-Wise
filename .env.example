# Optional local integrations. Copy this file to .env and add credentials locally.
# Built-in guideline and claim checks do not need an API key.

# Optional Neon PostgreSQL storage. Use the pooled URL for app queries.
# DATABASE_URL_UNPOOLED is used for schema migrations when supplied.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Optional Gemini review (this is the provider currently called by audit workflow)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Available adapter, not currently called by the audit workflow
OPENAI_API_KEY=

# Optional Slack webhook for notifications
SLACK_WEBHOOK_URL=

# Preferred email provider: Resend uses an API key and does not require Gmail
# 2-Step Verification or a Gmail App Password. RESEND_FROM must be an allowed
# sender in your Resend account (verify a domain for production delivery).
RESEND_API_KEY=
RESEND_FROM=

# Optional SMTP fallback if RESEND_API_KEY is not set. Gmail SMTP requires a
# Google App Password, which requires 2-Step Verification on the Google account.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
