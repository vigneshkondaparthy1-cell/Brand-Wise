# Optional local integrations. Copy this file to .env and add credentials locally.
# Built-in guideline and claim checks do not need an API key.

# Optional Neon PostgreSQL storage. Use the pooled URL for app queries.
# DATABASE_URL_UNPOOLED is used for schema migrations when supplied.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Optional Gemini review (this is the provider currently called by audit workflow)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Available adapter, not currently called by the audit workflow
OPENAI_API_KEY=

# Optional Slack webhook for notifications
SLACK_WEBHOOK_URL=

# Firebase email-link verification is used by the current registration, email
# change, and password-reset screens. This public project key is optional here;
# the application uses its project default when it is omitted. Enable Email link
# in Firebase Console and authorize your local and hosted domains.
FIREBASE_API_KEY=
